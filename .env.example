# Environment variables for Synapse RAG

# 1. Database Connection Strings (from Neon or Supabase)
# Use the pooled/transaction connection string for DATABASE_URL
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Use the direct/session connection string for DIRECT_URL (required for Prisma migrations)
DIRECT_URL=postgres://user:password@host/dbname?sslmode=require

# 2. LLM API Key (from console.groq.com)
GROQ_API_KEY="gsk_your_key_here"
GROQ_MODEL="openai/gpt-oss-20b"
# Comma-separated models tried if the configured model is unavailable
GROQ_FALLBACK_MODELS="qwen/qwen3.6-27b,llama-3.1-8b-instant"
# Maximum unique parent clauses inserted into one LLM prompt
MAX_PARENT_CLAUSES=6

# 3. Python FastAPI Backend URL (set in production to your deployed URL)
PYTHON_BACKEND_URL=http://localhost:8000

# 4. NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"

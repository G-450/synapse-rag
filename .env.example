# Environment variables for Synapse RAG

# 1. Database Connection Strings (from Neon or Supabase)
# Use the pooled/transaction connection string for DATABASE_URL
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Use the direct/session connection string for DIRECT_URL (required for Prisma migrations)
DIRECT_URL=postgres://user:password@host/dbname?sslmode=require

# 2. LLM API Key (from console.groq.com)
GROQ_API_KEY="gsk_your_key_here"

# 3. NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
